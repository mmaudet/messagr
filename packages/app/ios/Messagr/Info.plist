<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Messagr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<!-- The application's own scheme, so an invitation link opens it. Android
	     declares the same one in AndroidManifest.xml, whose comment explains
	     why only this scheme and not https as well: claiming an https link
	     needs Digital Asset Links published at the instance, and which
	     instances may vouch for this application is a deployment question
	     nobody has answered.

	     Without this, `messagr://` resolves to nothing on iOS and the
	     application cannot be entered at all, measured as
	     LSApplicationWorkspaceErrorDomain error 115 from `simctl openurl`. -->
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.messagr</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>messagr</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- LES DEUX TEXTES QU'APPLE A RECLAMES, ET POURQUOI L'UN EST UN AVEU.

	     ITMS-90683, sur la premiere livraison de #109 : le binaire reference des
	     API sensibles, donc l'Info.plist doit porter le texte correspondant,
	     "meme si votre app n'utilise pas ces API". Un build sans eux se
	     construit, se signe, se televerse et se fait refuser au traitement,
	     par courriel, une heure plus tard.

	     `scripts/assert-ios-purpose-strings.sh` refuse desormais ca dans
	     `checks`, a partir des dependances declarees. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Pour que votre correspondant vous entende pendant un appel. Le son est chiffré de bout en bout : ni le serveur ni Messagr ne peuvent l’écouter, et rien n’est enregistré.</string>
	<!-- UN TEXTE POUR UNE AUTORISATION QUI NE SERA JAMAIS DEMANDEE.
	     Messagr ne touche pas la camera : ce lot est audio, et la video n'est
	     pas offerte (#88). C'est `react-native-webrtc` qui reference l'API, et
	     Apple exige le texte de qui la reference, pas de qui l'appelle. Le
	     texte dit donc la verite plutot que d'annoncer une fonction absente :
	     si jamais il s'affichait, il ne mentirait pas. -->
	<key>NSCameraUsageDescription</key>
	<string>Messagr n’utilise pas l’appareil photo. Ce texte est exigé par iOS parce que la bibliothèque d’appels référence cette API ; l’autorisation ne vous sera pas demandée.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pour choisir une image à envoyer dans une conversation. L’image est chiffrée sur cet appareil avant d’être envoyée : ni le serveur ni Messagr ne peuvent la lire.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<!-- L'EXPORT N'EST PAS DECLARE ICI, ET APPLE EST CELUI QUI L'A TRANCHE.

	     Ce fichier a porte `ITSAppUsesNonExemptEncryption = true` pendant une
	     livraison, pour que la question cesse d'etre posee a chaque build.
	     Apple l'a refusee : erreur 90592, "Invalid Export Compliance Code. The
	     export compliance key value [] in the app's Info.plist doesn't match
	     the key value of the app's export compliance documentation".

	     La cle `true` n'est utilisable qu'accompagnee de
	     `ITSEncryptionExportComplianceCode`, le code qu'Apple delivre APRES
	     avoir recu la documentation d'export. Tant qu'on ne le detient pas, la
	     declarer est un renvoi vers un document qui n'existe pas.

	     Donc la question se repond dans App Store Connect, une fois par build,
	     ou l'interface pose les vraies questions et ou la reponse est signee
	     par une personne. Le jour ou le code existe, il vient ici avec la cle,
	     et `assert-ios-info-plist.sh` refuse l'une sans l'autre. -->

	<!-- WAKING A CLOSED APPLICATION.
	     Without this, iOS drops a content-available push instead of deferring
	     it: the application is never started and the notification is never
	     drawn. It cannot fail on a simulator, and it fails silently on a
	     device, so `assert-ios-push.sh` is what actually notices. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
