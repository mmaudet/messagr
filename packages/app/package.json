{
  "name": "@messagr/app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e:ios": "detox test --configuration ios.sim.release",
    "e2e:android": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "matrix-js-sdk": "^42.3.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-matrix-crypto": "^0.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "text-encoding-polyfill": "^0.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "detox": "^20.51.4",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.3.0 || >=26.0.0"
  }
}
