{
  "$meta": {
    "product": "Messagr",
    "version": "3.0.0",
    "source": "Messagr Prototype V3.dc.html",
    "targets": ["react-native", "tauri"],
    "note": "Palette normative. Aucune couleur hors de cette liste ne doit apparaître dans le produit."
  },

  "color": {
    "brand": {
      "green500": { "value": "#12b76a", "use": "Humain et vérifié. Action principale, accusé de lecture, marque." },
      "green700": { "value": "#0e8f63", "use": "Même sémantique sur fond clair : texte, bordure, lien." },
      "green100": { "value": "#eef8f2", "use": "Surface vérifiée : fond d'étiquette, bulle sortante claire." },
      "ink900": { "value": "#0c1f19", "use": "Fond des frontières de sécurité, texte fort." }
    },
    "agent": {
      "700": { "value": "#3a3630", "use": "Encre agent sur fond clair." },
      "400": { "value": "#918a7c", "use": "Agent sur fond sombre, contraste 4.6:1 sur ink900 (WCAG AA texte)." },
      "100": { "value": "#efeae0", "use": "Surface agent, fiche de capacités." },
      "border": { "value": "#b0a99b", "use": "Pointillé agent. Jamais un état désactivé." }
    },
    "wait": {
      "700": { "value": "#8a6d1f", "use": "Texte : en attente d'un geste humain ou du réseau." },
      "500": { "value": "#c9a94a", "use": "Marqueur, point d'état, envoi différé." },
      "200": { "value": "#ecdcae", "use": "Bordure." },
      "100": { "value": "#faf1d8", "use": "Surface : bandeau hors ligne, brouillon d'agent." }
    },
    "deny": {
      "700": { "value": "#7d3434", "use": "Texte de mesure : suspension, révocation, refus." },
      "500": { "value": "#a13b3b", "use": "Action de mesure. Jamais un avertissement." },
      "200": { "value": "#e6c3c3", "use": "Bordure de mesure." },
      "100": { "value": "#faeded", "use": "Surface de mesure." }
    },
    "neutral": {
      "900": { "value": "#1b1a19", "use": "Texte principal." },
      "600": { "value": "#6b665c", "use": "Texte secondaire." },
      "400": { "value": "#a8a196", "use": "Texte tertiaire, placeholder." },
      "300": { "value": "#d5cfc3", "use": "Contrôle inactif. Seul gris de désactivation autorisé." },
      "200": { "value": "#e4dfd4", "use": "Séparateur, bordure de liste." }
    },
    "surface": {
      "paper": { "value": "#fbf8f3", "use": "Fond d'écran clair par défaut." },
      "sunk": { "value": "#f2efe8", "use": "Fond de conversation." },
      "raised": { "value": "#ffffff", "use": "Bulle entrante, champ de saisie." }
    }
  },

  "font": {
    "system": {
      "ios": "SF Pro Text",
      "macos": "SF Pro Text",
      "android": "Roboto",
      "windows": "Segoe UI Variable"
    },
    "brand": { "value": "Schibsted Grotesk", "use": "Écran de marque et logotype uniquement." },
    "mono": { "value": "JetBrains Mono", "use": "Identifiants, empreintes, étiquettes techniques." }
  },

  "type": {
    "display":    { "size": 30,   "lineHeight": 36, "weight": 600, "tracking": "-0.03em" },
    "titleLg":    { "size": 22,   "lineHeight": 27, "weight": 600, "tracking": "-0.02em" },
    "titleMd":    { "size": 17,   "lineHeight": 22, "weight": 600 },
    "body":       { "size": 14.5, "lineHeight": 21, "weight": 400 },
    "bodySm":     { "size": 13,   "lineHeight": 19, "weight": 400 },
    "caption":    { "size": 11.5, "lineHeight": 17, "weight": 400 },
    "monoLabel":  { "size": 9.5,  "lineHeight": 14, "weight": 500, "tracking": "0.14em", "transform": "uppercase" },
    "monoId":     { "size": 11,   "lineHeight": 16, "weight": 400 }
  },

  "radius": { "bubble": 16, "bubbleAuthorCorner": 4, "pill": 26, "avatar": "50%" },

  "notch": {
    "$note": "Entaille à 45°, accent réservé aux boutons, cartes et marqueurs d'agent.",
    "button": { "size": 16, "corner": "top-right" },
    "card":   { "size": 22, "corner": "top-right" },
    "agent":  { "size": "32%", "corner": "bottom-right" }
  },

  "elevation": {
    "1":     "0 1px 1px rgba(12,31,25,.07)",
    "2":     "0 12px 28px rgba(12,31,25,.06)",
    "modal": "0 30px 70px rgba(12,31,25,.32)"
  },

  "motion": {
    "enter":  { "duration": 450,  "easing": "ease-out", "translateY": 8 },
    "toggle": { "duration": 180,  "easing": "ease" },
    "scan":   { "duration": 1900, "easing": "ease-in-out", "direction": "alternate" }
  },

  "layout": {
    "mobileMax": { "value": 430, "unit": "pt", "note": "Cible de référence." },
    "touchTargetMin": { "$ref": "floors.touchTargetMin" },
    "desktopBase": { "width": 900, "height": 600, "note": "Fenêtre Tauri par défaut, trois colonnes." },
    "desktopWide": { "min": 1180, "note": "Colonne d'agent 280px ; le fil ne dépasse pas 720px." },
    "desktopNarrow": { "max": 780, "note": "Colonne d'agent repliée en tiroir." },
    "tablet": { "status": "non traité en V1", "note": "À cadrer après la V3." }
  },

  "floors": {
    "$note": "Planchers §13.17. Valeurs contractuelles, destinées au lint §13.19 n°11 : toute valeur inférieure est un défaut.",
    "bodySizeMin": { "value": 11.5, "unit": "pt", "applies": "Tout texte de contenu ou d'interface.", "note": "Aucun corps sous 11,5 pt à l'écran." },
    "monoLabelSizeMin": { "value": 9.5, "unit": "pt", "applies": "Étiquettes JetBrains Mono capitales (type.monoLabel).", "note": "Seule exception au plancher de corps, et jamais en dessous de 9,5 pt." },
    "lineHeightRatioMin": { "value": 1.35, "applies": "Tout bloc de texte.", "note": "Rapport interligne / corps. Vérifiable sur chaque entrée de `type`." },
    "touchTargetMin": { "value": 44, "unit": "pt", "applies": "Toute cible tactile." }
  },

  "identifier": {
    "$note": "Arbitrage §2.7.",
    "format": "@prefix#SUFFIX",
    "suffixLength": 4,
    "alphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
    "excluded": ["0", "O", "1", "I"],
    "collision": "Aucune fusion : deux comptes de même préfixe restent deux lignes distinctes, suffixe en mono et en gras."
  }
}
