node_modules/
.DS_Store
*.log

# Rust build artifacts from the spike fixture (spikes/), which is built by
# hand and never by CI.
spikes/**/target/
# Tauri regenerates these on every build.
spikes/**/gen/

# Python bytecode from the interop counterparty.
__pycache__/
*.pyc

# Detox writes device logs and screenshots here on failure.
packages/app/.artifacts/

# Rust build output for the internalised service.
services/**/target/

# Agent worktrees. `Agent(isolation: "worktree")` checks a branch of this same
# repository out under here, so everything below is a second copy of the tree:
# git sees an embedded repository, eslint lints files that already have their
# own configuration, and prettier reformats a checkout somebody is working in.
# Scratch space, and none of the three should look at it.
.claude/worktrees/
